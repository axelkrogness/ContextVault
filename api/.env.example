DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/contextvault
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# Optional semantic embedding endpoint. It should accept {"input":"...","dimensions":64}
# and return {"embedding":[...]} or OpenAI-compatible {"data":[{"embedding":[...]}]}.
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSIONS=64
RATE_LIMIT_PER_MINUTE=60
